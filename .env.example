# ── Discord ──────────────────────────────────────────────────────────────────
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_GUILD_ID=                        # Optional: restrict slash command sync to one guild

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://betterlife:password@db:5432/betterlife

# ── Kafka ─────────────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_GROUP_ID=betterlifebot

# ── Todoist ───────────────────────────────────────────────────────────────────
# Used to verify incoming webhook payloads (HMAC-SHA256)
TODOIST_WEBHOOK_SECRET=your_webhook_secret_for_hmac

# ── Garmin Health SDK (OAuth 1.0a) ────────────────────────────────────────────
# Consumer credentials identify your app in the OAuth handshake
GARMIN_CONSUMER_KEY=your_garmin_consumer_key
GARMIN_CONSUMER_SECRET=your_garmin_consumer_secret
GARMIN_OAUTH_CALLBACK_URL=https://yourdomain.com/garmin/callback

# ── Google Calendar ───────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=https://yourdomain.com/google/callback

# ── OpenWeather ───────────────────────────────────────────────────────────────
OPENWEATHER_API_KEY=your_openweather_api_key

# ── Security ──────────────────────────────────────────────────────────────────
# 32-byte AES-256 key, base64-encoded:
#   python -c "import secrets,base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
ENCRYPTION_KEY=your_base64_encoded_32byte_key_here

# ── Webhook server ────────────────────────────────────────────────────────────
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8080

# ── Bot behaviour ─────────────────────────────────────────────────────────────
# Default sleep goal assigned to new users at /register (hours)
DEFAULT_SLEEP_GOAL_HOURS=8
